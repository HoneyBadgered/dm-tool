generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Campaign {
  id          String            @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  characters  PlayerCharacter[]
  sessions    Session[]
  npcs        Npc[]
  encounters  Encounter[]
  combats     Combat[]
  records     StoryRecord[]
  boards      Board[]
  battleMaps  BattleMap[]
  boardImages BoardImage[]
}

model PlayerCharacter {
  id                 String           @id @default(cuid())
  campaignId         String
  campaign           Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name               String
  playerName         String?
  maxHp              Int
  armorClass         Int
  initiativeModifier Int              @default(0)
  characterClass     String?
  race               String?
  level              Int?
  backstory          String?
  speed              String?
  passivePerception  Int?
  abilityScores      Json?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  encounterEntries   EncounterEntry[]
  combatants         Combatant[]
  boardNodes         BoardNode[]

  @@index([campaignId])
}

model Session {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  number     Int
  title      String?
  notes      String    @default("")
  isCurrent  Boolean   @default(false)
  playedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  boardNodes BoardNode[]

  @@unique([campaignId, number])
  @@index([campaignId])
}

model Npc {
  id                    String           @id @default(cuid())
  campaignId            String
  campaign              Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name                  String
  titleAlias            String?
  role                  String?
  status                String           @default("active")
  race                  String?
  characterClass        String?
  level                 Int?
  challengeRating       String?
  location              String?
  locationRecordId      String?
  locationRecord        StoryRecord?     @relation("NpcCurrentLocation", fields: [locationRecordId], references: [id], onDelete: SetNull)
  faction               String?
  factionRecordId       String?
  factionRecord         StoryRecord?     @relation("NpcFaction", fields: [factionRecordId], references: [id], onDelete: SetNull)
  quickSummary          String?
  appearance            String?
  personality           String?
  motivation            String?
  goals                 String?
  currentPlans          String?
  fearWeakness          String?
  secret                String?
  knowledgeClues        String?
  voiceMannerisms       String?
  partyRelationship     String?
  notes                 String?
  initiativeCombatNotes String?
  backstory             String?
  dmNotes               String?
  relationshipNotes     String?
  statBlockReference    String?
  firstAppearance       String?
  lastSeen              String?
  portraitUrl           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?
  encounterEntries      EncounterEntry[]
  combatants            Combatant[]
  boardNodes            BoardNode[]

  @@index([campaignId])
  @@index([locationRecordId])
  @@index([factionRecordId])
}

enum EncounterStatus {
  planned
  active
  resolved
}

model Encounter {
  id         String           @id @default(cuid())
  campaignId String
  campaign   Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String
  status     EncounterStatus  @default(planned)
  notes      String?
  objective  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?
  entries    EncounterEntry[]
  combats    Combat[]
  boardNodes BoardNode[]

  @@index([campaignId])
}

enum RuleEntryOrigin {
  imported
  homebrew
}

enum RuleImportMode {
  preview
  import
  sync
}

enum RuleImportStatus {
  running
  completed
  partial
  failed
}

model RuleSource {
  id                  String          @id @default(cuid())
  provider            String
  apiEdition          String
  apiBaseUrl          String
  srdLabel            String
  verifiedSrdRevision String?
  licenseName         String
  licenseUrl          String
  attribution         String
  lastFetchedAt       DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  entries             RuleEntry[]
  importRuns          RuleImportRun[]

  @@unique([provider, apiEdition])
}

model RuleEntry {
  id               String           @id @default(cuid())
  origin           RuleEntryOrigin
  category         String
  sourceKey        String?
  sourceId         String?
  source           RuleSource?      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  name             String
  rawData          Json
  contentHash      String?
  isActive         Boolean          @default(true)
  lastSeenAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  encounterEntries EncounterEntry[]
  combatants       Combatant[]

  @@unique([sourceId, category, sourceKey])
  @@index([category, isActive, name])
  @@index([origin, isActive])
}

model RuleImportRun {
  id            String           @id @default(cuid())
  sourceId      String
  source        RuleSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  collection    String?
  mode          RuleImportMode
  status        RuleImportStatus
  writesEnabled Boolean          @default(false)
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  discovered    Int              @default(0)
  valid         Int              @default(0)
  invalid       Int              @default(0)
  created       Int              @default(0)
  updated       Int              @default(0)
  unchanged     Int              @default(0)
  skipped       Int              @default(0)
  deactivated   Int              @default(0)
  errors        Json?
  summary       String?

  @@index([sourceId, startedAt])
}

// ---------------------------------------------------------------------------
// Combat tracker. Three separate layers:
//   creature templates  -> existing RuleEntry (monsters), Npc, PlayerCharacter (never mutated here)
//   encounter templates -> Encounter + EncounterEntry (editable only while planned)
//   live combat         -> Combat, Combatant, CombatEffect, CombatEvent (stat snapshots copied at creation)
// Constraints Prisma cannot express (partial unique indexes, CHECKs) live in the migration SQL.
// ---------------------------------------------------------------------------

enum CreatureKind {
  monster
  npc
  player_character
  custom
}

enum HpMode {
  average
  rolled
  manual
}

enum CombatSide {
  party
  enemy
  neutral
}

enum CombatStatus {
  setup
  running
  paused
  ended
}

enum CombatantStatus {
  active
  defeated
  removed
}

enum EffectKind {
  condition
  ongoing
}

enum EffectExpiryTrigger {
  none
  start_of_target_turn
  end_of_target_turn
  start_of_source_turn
  end_of_source_turn
}

enum CombatEventType {
  combat_created
  combat_status_changed
  combat_ended
  initiative_set
  turn_changed
  damage
  heal
  temp_hp_set
  max_hp_set
  effect_added
  effect_removed
  combatant_added
  combatant_removed
  combatant_restored
  visibility_changed
  combatant_updated
  note
  undo
}

model EncounterEntry {
  id                String           @id @default(cuid())
  encounterId       String
  encounter         Encounter        @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  kind              CreatureKind
  ruleEntryId       String?
  ruleEntry         RuleEntry?       @relation(fields: [ruleEntryId], references: [id], onDelete: Restrict)
  npcId             String?
  npc               Npc?             @relation(fields: [npcId], references: [id], onDelete: NoAction)
  playerCharacterId String?
  playerCharacter   PlayerCharacter? @relation(fields: [playerCharacterId], references: [id], onDelete: NoAction)
  label             String
  quantity          Int              @default(1)
  side              CombatSide?
  hpMode            HpMode           @default(average)
  overrides         Json?
  startsHidden      Boolean          @default(false)
  wave              Int              @default(0)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([encounterId, sortOrder])
}

model Combat {
  id                String         @id @default(cuid())
  campaignId        String
  campaign          Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  encounterId       String?
  encounter         Encounter?     @relation(fields: [encounterId], references: [id], onDelete: NoAction)
  name              String?
  status            CombatStatus   @default(setup)
  round             Int            @default(1)
  // Not a foreign key (Combat <-> Combatant would be circular); the service validates it.
  activeCombatantId String?
  version           Int            @default(0)
  eventSeq          Int            @default(0)
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  combatants        Combatant[]
  effects           CombatEffect[]
  events            CombatEvent[]
  boardNodes        BoardNode[]
  battleMaps        BattleMap[]

  @@index([campaignId, status])
  @@index([encounterId])
}

model Combatant {
  id                      String           @id @default(cuid())
  combatId                String
  combat                  Combat           @relation(fields: [combatId], references: [id], onDelete: Cascade)
  kind                    CreatureKind
  name                    String
  side                    CombatSide
  status                  CombatantStatus  @default(active)
  isHidden                Boolean          @default(false)
  wave                    Int              @default(0)
  initiative              Int?
  initiativeTieBreak      Int              @default(0)
  maxHp                   Int
  currentHp               Int
  tempHp                  Int              @default(0)
  armorClass              Int
  // Reference-only provenance; the live values come from statSnapshot.
  sourceRuleEntryId       String?
  sourceRuleEntry         RuleEntry?       @relation(fields: [sourceRuleEntryId], references: [id], onDelete: SetNull)
  sourceContentHash       String?
  sourceNpcId             String?
  sourceNpc               Npc?             @relation(fields: [sourceNpcId], references: [id], onDelete: SetNull)
  sourcePlayerCharacterId String?
  sourcePlayerCharacter   PlayerCharacter? @relation(fields: [sourcePlayerCharacterId], references: [id], onDelete: SetNull)
  statSnapshot            Json
  notes                   String?
  bossPhases              Json?
  currentPhase            Int              @default(0)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  effectsOnTarget         CombatEffect[]   @relation("EffectTarget")
  effectsFromSource       CombatEffect[]   @relation("EffectSource")

  @@index([combatId, status])
}

model CombatEffect {
  id                String              @id @default(cuid())
  combatId          String
  combat            Combat              @relation(fields: [combatId], references: [id], onDelete: Cascade)
  targetId          String
  target            Combatant           @relation("EffectTarget", fields: [targetId], references: [id], onDelete: Cascade)
  sourceCombatantId String?
  sourceCombatant   Combatant?          @relation("EffectSource", fields: [sourceCombatantId], references: [id], onDelete: SetNull)
  kind              EffectKind
  name              String
  // Rule entry sourceKey in the "conditions" category when this is a library condition.
  conditionIndex    String?
  note              String?
  concentration     Boolean             @default(false)
  startedRound      Int
  expiresAtRound    Int?
  expiryTrigger     EffectExpiryTrigger @default(none)
  metadata          Json?
  isActive          Boolean             @default(true)
  endedAt           DateTime?
  createdAt         DateTime            @default(now())

  @@index([combatId, isActive])
  @@index([targetId, isActive])
}

model CombatEvent {
  id                String          @id @default(cuid())
  combatId          String
  combat            Combat          @relation(fields: [combatId], references: [id], onDelete: Cascade)
  seq               Int
  type              CombatEventType
  round             Int
  actorCombatantId  String?
  targetCombatantId String?
  summary           String
  // Versioned { schemaVersion, changes[], detail } payload; see src/lib/validation/combat.ts.
  payload           Json
  undoneBySeq       Int?
  idempotencyKey    String?
  createdAt         DateTime        @default(now())

  @@unique([combatId, seq])
  @@unique([combatId, idempotencyKey])
  @@index([combatId, createdAt])
}

// ---- Campaign records and boards ---------------------------------------------
// Boards only store layout, relationships and grouping. Content lives in the
// linked records, so editing a record updates every board that shows it.

enum StoryRecordKind {
  faction
  location
  quest
  clue
  event
}

model StoryRecord {
  id           String          @id @default(cuid())
  campaignId   String
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind         StoryRecordKind
  name         String
  summary      String?
  dmNotes      String?
  details      Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  boardNodes   BoardNode[]
  npcLocations Npc[]           @relation("NpcCurrentLocation")
  npcFactions  Npc[]           @relation("NpcFaction")

  @@index([campaignId, kind])
}

enum BoardNodeKind {
  record
  note
  text
  sticky
  shape
  frame
  image
}

enum BoardNodeStatus {
  confirmed
  possible
  retired
}

enum BoardEdgeType {
  ally
  enemy
  serves
  knows_secret
  reveals_clue
  causes_event
  plain
}

model Board {
  id         String      @id @default(cuid())
  campaignId String
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  viewport   Json?
  version    Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  nodes      BoardNode[]
  edges      BoardEdge[]
  arcs       StoryArc[]

  @@index([campaignId])
}

model StoryArc {
  id      String      @id @default(cuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  color   String      @default("#2f5d3a")
  nodes   BoardNode[]

  @@index([boardId])
}

model BoardNode {
  id                String           @id @default(cuid())
  boardId           String
  board             Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  kind              BoardNodeKind
  x                 Float            @default(0)
  y                 Float            @default(0)
  status            BoardNodeStatus  @default(confirmed)
  title             String?
  text              String?
  dmNote            String?
  arcId             String?
  arc               StoryArc?        @relation(fields: [arcId], references: [id], onDelete: SetNull)
  npcId             String?
  npc               Npc?             @relation(fields: [npcId], references: [id], onDelete: SetNull)
  playerCharacterId String?
  playerCharacter   PlayerCharacter? @relation(fields: [playerCharacterId], references: [id], onDelete: SetNull)
  sessionId         String?
  session           Session?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  encounterId       String?
  encounter         Encounter?       @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  combatId          String?
  combat            Combat?          @relation(fields: [combatId], references: [id], onDelete: SetNull)
  recordId          String?
  record            StoryRecord?     @relation(fields: [recordId], references: [id], onDelete: SetNull)
  width             Float?
  height            Float?
  zIndex            Int              @default(0)
  locked            Boolean          @default(false)
  hidden            Boolean          @default(false)
  style             Json?
  parentId          String?
  parent            BoardNode?       @relation("FrameChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children          BoardNode[]      @relation("FrameChildren")
  imageId           String?
  image             BoardImage?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  outgoing          BoardEdge[]      @relation("EdgeSource")
  incoming          BoardEdge[]      @relation("EdgeTarget")

  @@index([boardId])
  @@index([imageId])
}

model BoardImage {
  id         String      @id @default(cuid())
  campaignId String
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mime       String
  sizeBytes  Int
  data       Bytes
  createdAt  DateTime    @default(now())
  nodes      BoardNode[]

  @@index([campaignId])
}

model BoardEdge {
  id       String        @id @default(cuid())
  boardId  String
  board    Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  sourceId String
  source   BoardNode     @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   BoardNode     @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type     BoardEdgeType
  label    String?
  style    Json?

  @@index([boardId])
}

model BattleMap {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  cols        Int       @default(30)
  rows        Int       @default(20)
  cellSize    Int       @default(50)
  feetPerCell Int       @default(5)
  bgMime      String?
  bgData      Bytes?
  bgWidth     Int?
  bgHeight    Int?
  bgRev       Int       @default(0)
  bgScale     Float     @default(1)
  bgX         Float     @default(0)
  bgY         Float     @default(0)
  state       Json
  version     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  combatId    String?
  combat      Combat?   @relation(fields: [combatId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([combatId])
}

model Slug {
  id        String   @id @default(cuid())
  kind      String
  slug      String
  entityId  String
  createdAt DateTime @default(now())

  @@unique([kind, slug])
  @@unique([kind, entityId])
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      AuthSession[]
  accounts      Account[]
}

model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
